<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="MailApp">

<Id>716B1235-F8EE-40CF-89A5-0ECD4D33396B</Id>
<Version>2.0.0.0</Version>
<ProviderName>SED</ProviderName>
<DefaultLocale>en-US</DefaultLocale>
<DisplayName DefaultValue="SED Email Downloader (DEV)"/>
<Description DefaultValue="Download emails directly from Outlook"/>
<IconUrl DefaultValue="https://alvar0murga.github.io/download-email-eml/docs/assets/sed-icon-64-v2.png"/>
<HighResolutionIconUrl DefaultValue="https://alvar0murga.github.io/download-email-eml/docs/assets/sed-icon-128-v2.png"/>
<SupportUrl DefaultValue="https://github.com/alvar0murga/download-email-eml"/>
<AppDomains>
  <AppDomain>https://alvar0murga.github.io</AppDomain>
</AppDomains>

<Hosts>
  <Host Name="Mailbox"/>
</Hosts>
<Requirements>
  <Sets>
  </Sets>
</Requirements>

<FormSettings>
  <Form xsi:type="ItemRead">
    <DesktopSettings>
      <SourceLocation DefaultValue="https://alvar0murga.github.io/download-email-eml/docs/taskpane.html"/>
      <RequestedHeight>450</RequestedHeight>
    </DesktopSettings>
  </Form>
</FormSettings>

<Permissions>ReadWriteItem</Permissions>

<Rule xsi:type="RuleCollection" Mode="Or">
  <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
</Rule>

<DisableEntityHighlighting>false</DisableEntityHighlighting>

</OfficeApp>